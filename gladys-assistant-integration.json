        {
          "value": "2",
          "label": {
            "en": "Every 2 minutes",
            "fr": "Toutes les 2 minutes",
            "de": "Alle 2 Minuten",
            "es": "Cada 2 minutos"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "Every 5 minutes",
            "fr": "Toutes les 5 minutes",
            "de": "Alle 5 Minuten",
            "es": "Cada 5 minutos"
          }
