{
  "manifest_version": 1,
  "type": "device",
  "name": "Lichess & Chess.com",
  "description": {
    "en": "Follow chess players on Lichess and Chess.com: ratings, today's games, records, last game.",
    "fr": "Suivez des joueurs d'échecs sur Lichess et Chess.com : classements, parties du jour, records.",
    "de": "Verfolge Schachspieler auf Lichess und Chess.com: Wertungen, Partien des Tages, Rekorde.",
    "es": "Siga a jugadores de ajedrez en Lichess y Chess.com: puntuaciones, partidas del día, récords."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-chess:1.0.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-chess/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Players to follow",
        "fr": "Joueurs à suivre",
        "de": "Verfolgte Spieler",
        "es": "Jugadores que seguir"
      },
      "description": {
        "en": "Type usernames: yours, your family's, your club's. Public data only, no account and no password. Not affiliated with Lichess or Chess.com.",
        "fr": "Saisissez des pseudos : le vôtre, ceux de la famille, du club. Données publiques seulement, sans compte ni mot de passe. Non affilié à Lichess ni à Chess.com.",
        "de": "Gib Benutzernamen ein: deinen, die deiner Familie, deines Vereins. Nur öffentliche Daten, ohne Konto und ohne Passwort. Nicht mit Lichess oder Chess.com verbunden.",
        "es": "Escriba nombres de usuario: el suyo, los de su familia, los de su club. Solo datos públicos, sin cuenta ni contraseña. Sin afiliación con Lichess ni Chess.com."
      },
      "links": [
        {
          "url": "https://lichess.org",
          "label": {
            "en": "Lichess",
            "fr": "Lichess",
            "de": "Lichess",
            "es": "Lichess"
          }
        },
        {
          "url": "https://www.chess.com",
          "label": {
            "en": "Chess.com",
            "fr": "Chess.com",
            "de": "Chess.com",
            "es": "Chess.com"
          }
        }
      ]
    },
    {
      "key": "lichess_players",
      "type": "string",
      "label": {
        "en": "Lichess players",
        "fr": "Joueurs Lichess",
        "de": "Lichess-Spieler",
        "es": "Jugadores de Lichess"
      },
      "description": {
        "en": "Lichess usernames (or profile links), separated by commas, 10 at most.",
        "fr": "Pseudos Lichess (ou liens de profil), séparés par des virgules, 10 au plus.",
        "de": "Lichess-Benutzernamen (oder Profillinks), durch Kommas getrennt, höchstens 10.",
        "es": "Usuarios de Lichess (o enlaces de perfil), separados por comas, 10 como máximo."
      },
      "placeholder": {
        "en": "e.g. thibault, DrNykterstein",
        "fr": "ex. thibault, DrNykterstein",
        "de": "z. B. thibault, DrNykterstein",
        "es": "p. ej. thibault, DrNykterstein"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "chesscom_players",
      "type": "string",
      "label": {
        "en": "Chess.com players",
        "fr": "Joueurs Chess.com",
        "de": "Chess.com-Spieler",
        "es": "Jugadores de Chess.com"
